<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Everything else is backed up as before; only the keys are left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
